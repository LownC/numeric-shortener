# Copy values only to your private local .env; never put real secrets here.
DATABASE_URL=postgresql://shortener_app:CHANGE_ME@127.0.0.1:15432/numeric_shortener
PUBLIC_BASE_URL=http://127.0.0.1:18080
APP_ENV=production
CREATE_URLS_ENABLED=false
# Required only when explicitly enabling protected creation; use a private random secret.
PROXY_SHARED_SECRET=
# Unauthenticated creation is allowed only in an explicit loopback DEBUG session.
ALLOW_INSECURE_LOCAL_CREATE=false
# .env.migration is separate and is never read by the application.
# MIGRATION_DATABASE_URL=postgresql://shortener_migrator:CHANGE_ME@127.0.0.1:15432/numeric_shortener
