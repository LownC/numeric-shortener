{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "numeric-shortener",
  "main": "./edge/worker.ts",
  "compatibility_date": "2026-11-10",
  "workers_dev": true,
  "send_metrics": false,
  "durable_objects": { "bindings": [{ "name": "CREATION_LIMITER", "class_name": "CreationLimiter" }] },
  "migrations": [{ "tag": "creation-limiter-v1", "new_sqlite_classes": ["CreationLimiter"] }],
  "assets": {
    "directory": "./dist/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": { "LOCAL_DEV": "false", "CREATE_URLS_ENABLED": "false" },
  "dev": { "ip": "127.0.0.1", "port": 18787, "local_protocol": "http" }
}
